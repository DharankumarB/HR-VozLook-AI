# ---------------------------------------------------------------------------
# VozLook InterviewAI — environment template
# Copy to `.env` (repo root) or `server/.env` and fill in what you need.
# NEVER commit real keys. `.env` files are git-ignored.
# ---------------------------------------------------------------------------

# ---- AI (optional) ---------------------------------------------------------
# Without this key the app runs on the built-in VozLook analysis engine.
# With it, résumé/JD extraction, question generation, answer grading, reports and
# coaching are served by Gemini through the backend (the key never reaches the browser).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Force the deterministic local engine even when a key is present.
AI_ENGINE=
# Per-call timeout and retry budget for provider calls before falling back locally.
# AI_TIMEOUT_MS=45000
# AI_MAX_RETRIES=2
# GOOGLE_API_KEY works as an alias for GEMINI_API_KEY.
GOOGLE_API_KEY=

# ---- Database --------------------------------------------------------------
# auto (default) -> Supabase when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, otherwise SQLite
# sqlite         -> always use the local SQLite file (server/data/vozlook.db)
# supabase       -> always use Postgres (fails loudly if credentials are missing)
DATA_MODE=auto
# Where the SQLite database and uploaded files live (defaults to server/data).
# DATA_DIR=

# ---- Supabase (production mode) -------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ---- Server ----------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
SESSION_DAYS=30
MAX_UPLOAD_MB=10
# Comma-separated extra origins allowed to call the API from a browser.
# The Vite dev server proxies /api, so this is only needed for split deployments.
CORS_ORIGINS=
# Set the generated secret in production; dev falls back to a persisted local secret.
JWT_SECRET=
# In development the password-reset link is returned by the API because no mail
# provider is configured. Set to false in production.
EXPOSE_RESET_LINK=true

# ---- Frontend (Vite) -------------------------------------------------------
# Leave blank to use the local JWT auth flow through the Express API (default).
# Fill both to enable Supabase Auth in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Dev-server proxy target when the API is not on http://127.0.0.1:8787
# VITE_API_TARGET=http://127.0.0.1:8787
# Keep false: the app always uses real data and real API calls.
VITE_DEMO_MODE=false
